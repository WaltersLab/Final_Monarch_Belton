qx = n_event / n_risk,
logqx = log(qx)
)
return(life_table)
}
life_tables <- list()
for(sex_i in unique(Bicyclus$Sex)) {
for(line_i in unique(Bicyclus$Line)) {
df_group <- Bicyclus %>% filter(Sex == sex_i, Line == line_i)
lt <- make_life_table(df_group)
if(!is.null(lt)) {
lt$Sex <- sex_i
lt$Line <- line_i
life_tables[[paste(line_i, sex_i, sep="_")]] <- lt
}
}
}
all_life_table <- bind_rows(life_tables)
palette_female <- c(
"WZ.female" = "#CC79A7",
"Z0.female" = "#F1B6DA"
)
palette_male <- c(
"WZ.male" = "#0072B2",
"Z0.male" = "#56B4E9"
)
plot_mortality_curves <- function(df, yvar, ylab, main_title,
ylim = c(0,1), add_trend = FALSE) {
df$LineSex <- factor(interaction(df$Line, df$Sex))
uniq_sex <- unique(df$Sex)
if (length(uniq_sex) != 1) {
stop("Data must contain only one Sex for correct palette selection")
}
palette_used <- if (uniq_sex == "female") palette_female else palette_male
p <- ggplot(df, aes(x = time,
y = .data[[yvar]],
color = LineSex,
group = LineSex)) +
geom_line(linewidth = 1) +
geom_point(size = 2) +
labs(x = "Days Since Eclosion",
y = ylab,
title = main_title,
color = "Line & Sex") +
coord_cartesian(ylim = ylim) +
scale_color_manual(values = palette_used) +
theme_bicyclus
if (add_trend) {
p <- p + geom_smooth(method = "loess",
se = FALSE,
linetype = "dashed")
} #use lm
return(p)
}
par(mfrow = c(2, 2), mar = c(4.5, 5, 3, 2))
plot_mortality_curves(
all_life_table %>% filter(Sex == "female"),
"qx",
"Daily mortality rate (qx)",
"Female",
ylim = c(0,0.9))
#raise ylim
plot_mortality_curves(
all_life_table %>% filter(Sex == "female"),
"logqx",
"log(Daily mortality rate)",
"Female (log scale)",
ylim = c(-7,1),
add_trend = TRUE)
plot_mortality_curves(
all_life_table %>% filter(Sex == "male"),
"qx",
"Daily mortality rate (qx)",
"Male",
ylim = c(0,0.9))
plot_mortality_curves(
all_life_table %>% filter(Sex == "male"),
"logqx",
"log(Daily mortality rate)",
"Male (log scale)",
ylim = c(-7,1),
add_trend = TRUE)
doLRT <- function(fitMore, fitLess, degfree = 1) {
lrt_stat <- 2 * (logLik(fitMore) - logLik(fitLess))
p_value <- pchisq(lrt_stat, df = degfree, lower.tail = FALSE)
outvec <- c("p.val" = p_value, "lrtStat" = lrt_stat)
return(outvec)
}
Bicyclus$event <- 1
survBike <- Surv(Bicyclus$days, Bicyclus$event)
fit_gp_null <- flexsurvreg(
survBike ~ 1,
data = Bicyclus,
dist = "gompertz"
)
fit_gp_sex <- flexsurvreg(
survBike ~ Sex,
data = Bicyclus,
dist = "gompertz"
)
fit_gp_sex_strain <- flexsurvreg(
survBike ~ Sex + Line,
data = Bicyclus,
dist = "gompertz"
)
fit_gp_interaction <- flexsurvreg(
survBike ~ Sex * Line,
data = Bicyclus,
dist = "gompertz"
)
fit_wb_null <- flexsurvreg(
survBike ~ 1,
data = Bicyclus,
dist = "weibullPH"
)
fit_wb_sex <- flexsurvreg(
survBike ~ Sex,
data = Bicyclus,
dist = "weibullPH"
)
fit_wb_sex_strain <- flexsurvreg(
survBike ~ Sex + Line,
data = Bicyclus,
dist = "weibullPH"
)
fit_wb_interaction <- flexsurvreg(
survBike ~ Sex * Line,
data = Bicyclus,
dist = "weibullPH"
)
modelDeltas <- matrix(nrow = 3, ncol = 2)
rownames(modelDeltas) <- unique(fit_tbl$formula)
fit_tbl <- tibble(
model_name = c(
"wb_null", "wb_sex", "wb_sex_size","fit_wb_interaction",
"gp_null", "gp_sex", "gp_sex_size","fit_gp_interaction"
),
family = c(
"Weibull", "Weibull", "Weibull", "Weibull",
"Gompertz", "Gompertz", "Gompertz", "Gompertz"
),
formula = c(
"~ 1", "~ Sex", "~ Sex + Strain", "~ Sex x Strain",
"~ 1", "~ Sex", "~ Sex + Strain", "~ Sex x Strain"
),
fit = list(
fit_wb_null, fit_wb_sex, fit_wb_sex_strain, fit_wb_interaction,
fit_gp_null, fit_gp_sex, fit_gp_sex_strain, fit_gp_interaction
)
) %>%
mutate(
npars  = map_int(fit, ~ length(coef(.x))),
logLik = map_dbl(fit, ~ as.numeric(logLik(.x))),
AIC    = map_dbl(fit, AIC),
BIC    = map_dbl(fit, BIC)
) %>%
arrange(AIC)
fit_tbl %>%
select(model_name, family, formula, npars, logLik, AIC, BIC) %>%
kbl() %>%  kable_classic("striped") %>%
scroll_box(width = "100%")
modelDeltas <- matrix(nrow = 3, ncol = 2)
rownames(modelDeltas) <- unique(fit_tbl$formula)
modelDeltas <- matrix(nrow = 4, ncol = 2)
rownames(modelDeltas) <- unique(fit_tbl$formula)
colnames(modelDeltas) <- c("AIC", "BIC")
for (form in unique(fit_tbl$formula)) {
tmp_tbl <- fit_tbl[fit_tbl$formula == form, ]
modelDeltas[form, "AIC"] <- tmp_tbl$AIC[tmp_tbl$family == "Gompertz"] -
tmp_tbl$AIC[tmp_tbl$family == "Weibull"]
modelDeltas[form, "BIC"] <- tmp_tbl$BIC[tmp_tbl$family == "Gompertz"] -
tmp_tbl$BIC[tmp_tbl$family == "Weibull"]
}
modelDeltas |> kbl() %>%  kable_classic("striped", full_width = F)
