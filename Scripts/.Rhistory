set.seed(69)
permutation <- gall[sample(dim(gall)[1], dim(gall)[1], replace = F),]
validation <- permutation[1:floor(.75 * dim(gall)[1]),]
test <- permutation[(floor(.75*dim(gall)[1])+1):dim(gall)[1],]
diag <- rpart(Gallstone.Status ~ ., data = validation, method = "class")
print(diag)
rpart.plot(diag, extra = 101)
diag_predict <- predict(diag, type = "class")
table(diag_predict, validation$Gallstone.Status)
sum(diag_predict!=validation$Gallstone.Status)/dim(gall)[1]
full_tree <- rpart(Gallstone.Status ~ ., data = validation, method = "class", control = rpart.control(cp=0, minsplit=1))
print(full_tree)
rpart.plot(full_tree, extra = 101)
full_predict <- predict(full_tree, type = "class")
table(full_predict , validation$Gallstone.Status)
sum(full_predict!=validation$Gallstone.Status)/dim(gall)[1]
kmer <- 10
group <- rep(1:kmer, length.out = dim(validation)[1])
NA_kmer <- NA * kmer
for (n in 1:kmer)
{
kmer_model <- rpart(Gallstone.Status ~ ., data = validation[group!= n,], method = "class")
# prediction values
pred_kmer <- predict(kmer_model, validation[group==n,], type = "class")
NA_kmer[n] <- sum(pred_kmer!=validation$Gallstone.Status[group ==n])/sum(group==n)
}
mean(NA_kmer)
for (n in 1:kmer)
{
kmer_model <- rpart(Gallstone.Status ~ ., data = validation[group!= n,], method = "class",control = rpart.control(cp=0, minsplit=1))
# prediction values
pred_kmer <- predict(kmer_model, validation[group==n,], type = "class")
NA_kmer[n] <- sum(pred_kmer!=validation$Gallstone.Status[group ==n])/sum(group==n)
}
mean(NA_kmer)
