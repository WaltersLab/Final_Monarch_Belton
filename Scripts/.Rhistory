LFC     <- 0.5     # matches script 05
A       <- 0.05    # BH-FDR cutoff
dds <- readRDS(file.path(in_dir, "dds_joint_normalised.rds"))
# VST expression matrix for PCA / sample distances
mat <- assay(vst(dds, blind = TRUE))
# Drop any zero-variance genes (they cannot be z-scored)
rv  <- matrixStats::rowVars(mat)
mat <- mat[rv > 0, ]
tissue <- colData(dds)$Tissue
names(tissue) <- colnames(mat)
batch <-colData(dds)$Batch
names(batch) <- colnames(mat)
sex <- colData(dds)$Sex
names(sex) <- colnames(mat)
age <- colData(dds)$Age
names(age) <- colnames(mat)
cat("VST matrix: ", nrow(mat), " genes x ", ncol(mat), " samples\n", sep = "")
cat("Suspect: ", SUSPECT, " (labelled ", as.character(tissue[SUSPECT]), ")\n", sep = "")
# Gene-wise z-scores
z <- t(scale(t(mat)))
# Sample distances
sample_dist_matrix <- as.matrix(dist(t(mat)))
counts_mat <- counts(dds, normalized = FALSE)
library_qc <- data.frame(
sample = colnames(counts_mat),
expected_counts = colSums(counts_mat),
detected_retained+genes = colSums(counts_mat > 0),
library_qc[
library_qc$sample %in% c("Cp07_31", "Cp07_35", "Cp07_39"),
c(
"sample",
"expected_counts",
"detected_retained_genes",
"zero_percent_retained_genes"
)
]
counts_mat <- counts(dds, normalized = FALSE)
library_qc <- data.frame(
sample = colnames(counts_mat),
expected_counts = colSums(counts_mat),
detected_retained+genes = colSums(counts_mat > 0),
counts_mat <- counts(dds, normalized = FALSE)
library_qc <- data.frame(
sample = colnames(counts_mat),
expected_counts = colSums(counts_mat),
detected_retained_genes = colSums(counts_mat > 0),
zero_fraction_retained_genes = colMeans(counts_mat == 0)
)
library_qc$zero_percent_retained_genes <- 100 * library_qc$zero_fraction_retained_genes
# Cydia only
cydia_qc <- library_qc[
grepl("^Cp", library_qc$sample),
]
cydia_qc <- cydia_qc[
order(cydia_qc$expected_counts),
]
cydia_qc
cydia_qc[
order(-cydia_qc$zero_fraction_retained_genes),
c("sample", "expected_counts","detected_retained_genes", "zero_percent_retained_genes")
]
suppressPackageStartupMessages({
library(DESeq2)
library(sva)
library(ggplot2)
library(ggrepel)
library(matrixStats)
library(here)
})
in_dir <- here("02_Diff_Expression", "Results", "Tables")
fig_dir <- here("02_Diff_Expression", "Results", "Figures")
tab_dir <- here("02_Diff_Expression", "Results", "Tables")
dir.create(fig_dir, recursive = TRUE, showWarnings = FALSE)
# Appended to every output of this branch so it never overwrites the with-Pi29_19 run.
# If this branch later becomes canonical, set SUFFIX <- "" to drop the suffix everywhere.
SUFFIX <- "_no_Cp07_31_Cp07_35_and_Cp07_39"
dds_head   <- readRDS(file.path(in_dir, "dds_head_normalised.rds"))
dds_thorax <- readRDS(file.path(in_dir, "dds_thorax_normalised.rds"))
# Apply the predefined Step-3b QC exclusion set
n_before <- ncol(dds_head)
EXCLUDE  <- c("Cp07_31","Cp07_35","Cp07_39")
dds_head <- dds_head[, !colnames(dds_head) %in% EXCLUDE]
if (ncol(dds_head) < n_before) {
dds_head <- estimateSizeFactors(dds_head)
cat("Excluded ", n_before - ncol(dds_head), " sample(s) from head: ",
paste(EXCLUDE, collapse = ", "), " (head normalisation re-estimated)\n", sep = "")
}
cat("Loaded datasets after QC exclusion:\n")
cat("  head:   ", nrow(dds_head),   " genes x ", ncol(dds_head),   " samples\n", sep = "")
cat("  thorax: ", nrow(dds_thorax), " genes x ", ncol(dds_thorax), " samples\n", sep = "")
design_audit <- function(dds, label) {
cd <- as.data.frame(colData(dds))
required_vars <- c("Tissue", "Age", "Sex", "Batch")
missing_vars <- setdiff(required_vars, colnames(cd))
if (length(missing_vars) > 0) {
stop(
"Missing required design variables for ",
label,
": ",
paste(missing_vars, collapse = ", ")
)
}
audit <- as.data.frame(
table(
Age = cd$Age,
Sex = cd$Sex,
Batch = cd$Batch
)
)
audit <- audit[audit$Freq > 0, ]
audit$Tissue <- label
audit <- audit[
,
c("Tissue", "Age", "Sex", "Batch", "Freq")
]
rownames(audit) <- NULL
audit
}
design_head <- design_audit(dds_head, "HEAD")
design_thorax <- design_audit(dds_thorax, "THORAX")
cat("=== Head design after QC exclusion ===\n")
print(design_head, row.names = FALSE)
cat("\n=== Thorax design after QC exclusion ===\n")
print(design_thorax, row.names = FALSE)
write.table(
design_head,
file.path(
tab_dir,
paste0("design_audit_head", SUFFIX, ".tsv")
),
sep = "\t",
quote = FALSE,
row.names = FALSE
)
write.table(
design_thorax,
file.path(
tab_dir,
paste0("design_audit_thorax", SUFFIX, ".tsv")
),
sep = "\t",
quote = FALSE,
row.names = FALSE
)
dds <- readRDS(file.path(in_dir, "dds_joint_normalised.rds"))
mat <- assay(vst(dds, blind = TRUE))
# Drop any zero-variance genes (they cannot be z-scored), then standardise gene-wise.
rv  <- matrixStats::rowVars(mat)
mat <- mat[rv > 0, ]
z   <- t(scale(t(mat)))                       # genes x samples, z-scored per gene
tissue <- colData(dds)$Tissue
names(tissue) <- colnames(mat)
cat("VST matrix: ", nrow(mat), " genes x ", ncol(mat), " samples\n", sep = "")
cat("Tissue labels:\n")
print(table(tissue))
cat("\nSamples evaluated: ", ncol(mat), "\n", sep = "")
print(colnames(mat))
anno_path <- file.path(in_dir, "gene_annotations.tsv")
have_anno <- file.exists(anno_path)
if (have_anno) {
anno <- read.delim(anno_path, stringsAsFactors = FALSE)
desc <- setNames(
anno$description,
anno$gene_symbol
)[rownames(mat)]
cat("Loaded annotations for ", sum(!is.na(desc)), " of ", nrow(mat), " genes.\n", sep = "")
} else {
desc <- setNames(rep(NA_character_, nrow(mat)), rownames(mat))
warning("gene_annotations.tsv not found; section 2 (named marker panel) will be skipped.")
}
