type = "survival",
ci = FALSE
)
pred_XY <- summary(
flex_fit,
newdata = data.frame(
Sex = sex_to_plot,
Strain = "XY"
),
t = ages,
type = "survival",
ci = FALSE
)
## -------------------------
## Draw plot
## -------------------------
draw_plot <- function() {
par(
mar = c(4, 4, 0.5, 1),
cex.lab = 0.8,
cex.axis = 0.8
)
## XO observed — solid step curve
plot(
km_XO$time,
km_XO$surv,
type = "s",
col = "forestgreen",
lwd = 2,
xlim = c(0, max(surv_data$Lifespan)),
ylim = c(0, 1),
xlab = "Age",
ylab = "Survival probability"
)
## XY observed — solid step curve
lines(
km_XY$time,
km_XY$surv,
type = "s",
col = "purple",
lwd = 2
)
## XO predicted — DOTTED
lines(
pred_XO[[1]]$time,
pred_XO[[1]]$est,
col = "forestgreen",
lwd = 1.5,
lty = 3
)
## XY predicted — DOTTED
lines(
pred_XY[[1]]$time,
pred_XY[[1]]$est,
col = "purple",
lwd = 1.5,
lty = 3
)
## Legend
legend(
"topright",
legend = c(
"XO observed",
"XO predicted",
"XY observed",
"XY predicted"
),
col = c(
"forestgreen", "forestgreen",
"purple", "purple"
),
lty = c(
1, 3,
1, 3
),
lwd = c(
2, 1.5,
2, 1.5
),
bty = "n",
cex = 0.7
)
}
## Show
draw_plot()
## Save
if (!is.null(outfile)) {
jpeg(
outfile,
width = 90,
height = 75,
units = "mm",
res = 300
)
draw_plot()
dev.off()
}
}
plot_survival(
f_wb_shape_strain,
sex_to_plot = "Female"
)
