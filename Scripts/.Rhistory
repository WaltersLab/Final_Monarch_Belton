library(flexsurv)
library(ggplot2)
library(tidyverse)
library(ggfortify)# for `autoplot` with survfit
library(survminer)
library(kableExtra)
library(patchwork)
library(splines)
library(muhaz)
monsurv_full <- read.csv(("../Input_Data/MonarchAgingData_2026_01_08.csv"))
monsurv <- monsurv_full %>%
mutate(Sex = str_trim(Sex)) %>%
filter(Sex %in% c("Male", "Female")) %>%
mutate(
DeathDate = as.Date(DeathDate),
EclosionDate = as.Date(EclosionDate),
AgeCalc = DeathDate - EclosionDate
) %>%
filter(Age < 84)  # Remove age outliers
tapply(monsurv$Age, monsurv$Sex, FUN=summary)
any(monsurv_full$AgeCalc != monsurv_full$Age)
monsurv$Sex <- factor(monsurv$Sex, levels = c("Male", "Female"))
monsurv$event <- 1
monsurv$FWdc_z <- as.numeric(scale(monsurv$Discal.cell.forewing))
save(monsurv, file = "../Input_Data/monsurv.Rdata")
theme_monarch <- theme_bw(base_size = 12) +
theme(
plot.title = element_text(face = "bold", hjust = 0.5, size = 14),
axis.title = element_text(face = "bold", size = 13),
axis.text = element_text(face = "bold", size = 11),
strip.text = element_text(face = "bold")
)
sex_colors <- c("Male" = "dodgerblue","Female" = "firebrick2")
full_histo_plot <- monsurv %>%
filter(!is.na(Sex)) %>%
ggplot(aes(x = Age, fill = Sex)) +
geom_histogram(binwidth = 1, color = "white") +
facet_wrap(~Sex, scales = "free_y", ncol = 1) +
scale_fill_manual(values = sex_colors) +
labs(
x = "Days Since Eclosion",
y = "Number of Individuals")
+
theme_monarch
full_histo_plot <- monsurv %>%
filter(!is.na(Sex)) %>%
ggplot(aes(x = Age, fill = Sex)) +
geom_histogram(binwidth = 1, color = "white") +
facet_wrap(~Sex, scales = "free_y", ncol = 1) +
scale_fill_manual(values = sex_colors) +
labs(
x = "Days Since Eclosion",
y = "Number of Individuals") +
theme_monarch
print(full_histo_plot)
library(flexsurv)
library(ggplot2)
library(tidyverse)
library(ggfortify)# for `autoplot` with survfit
library(survminer)
library(kableExtra)
library(patchwork)
library(splines)
library(muhaz)
library(reporter)
library(gtsummary)
library(stringr)
load(file = "../Input_Data/monsurv.Rdata")
save_file <- function(test_obj, label, file){
cat(
"\n-----------------------------------\n",
label,
"\n-----------------------------------\n",
file = file,
append = TRUE
)
capture.output(
test_obj,
file = file,
append = TRUE
)
}
survival_stats <- "../Results/Survival_CoxPH/Statistics/survival_stats.txt"
cat(
"Monarch Manuscript Survival Results\n",
"=================================\n\n",
file = survival_stats
)
mortality_stats <- "../Results/Survival_CoxPH/Statistics/mortality_statistics.txt"
cat(
"Monarch Manuscript Mortality Results\n",
"=================================\n\n",
file = mortality_stats
)
coxph_stats <- "../Results/Survival_CoxPH/Statistics/coxph_statistics.txt"
cat(
"Monarch Manuscript Cox Proportional Hazards Results\n",
"=================================\n\n",
file = coxph_stats
)
anova_stats <- "../Results/Survival_CoxPH/Statistics/ANOVA_statistics.txt"
cat(
"Monarch Manuscript Cox Proportional Hazards ANOVA Results\n",
"=================================\n\n",
file = anova_stats
)
diagnostics_stats <- "../Results/Survival_CoxPH/Statistics/diagnostics_statistics.txt"
cat(
"Monarch Manuscript Diagnostics of Cox Proportional Hazards Models\n",
"=================================\n\n",
file = diagnostics_stats
)
theme_monarch <- theme_bw(base_size = 12) +
theme(
plot.title = element_text(face = "bold", hjust = 0.5, size = 14),
axis.title = element_text(face = "bold", size = 13),
axis.text = element_text(face = "bold", size = 11),
strip.text = element_text(face = "bold")
)
sex_colors <- c("Male" = "dodgerblue","Female" = "firebrick2")
survMon <- Surv(time = monsurv$Age, event = monsurv$event)
survMon.diff <- survdiff(survMon ~ Sex, data = monsurv)
print(survMon.diff)
save_file(survMon.diff,"Kaplan-Mier statistics", survival_stats)
p <- survMon.diff$pvalue
save_file(p,"Kaplan-Mier p-value", survival_stats)
p <- survMon.diff$pvalue
save_file(p,"Kaplan-Mier p-value", survival_stats)
print(p)
